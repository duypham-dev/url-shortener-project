generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model click_logs {
  id             BigInt    @id @default(autoincrement())
  url_mapping_id BigInt   // Khóa ngoại trỏ đến ID của bảng url_mappings
  short_code     String    @db.VarChar(10)
  user_id        Int?      
  
  clicked_at     DateTime? @default(now()) @db.Timestamptz(6)
  ip_address     String?   @db.Inet
  

  browser        String?   @db.VarChar(50)
  os             String?   @db.VarChar(50)
  device_type    String?   @db.VarChar(50)
  
  user_agent     String?   // Vẫn giữ chuỗi thô để dự phòng/debug
  referrer       String?   @db.VarChar(255)
  country        String?   @db.VarChar(100)

  // Relations
  url_mappings   url_mappings? @relation(fields: [url_mapping_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users          users?        @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  // Các Index tối ưu cho truy vấn Time-series và Realtime
  @@index([user_id, clicked_at(sort: Desc)], map: "idx_logs_realtime_stream")
  @@index([short_code, clicked_at(sort: Desc)], map: "idx_logs_by_link")
}

model payments {
  id               String         @id @default(cuid()) @db.VarChar(255)
  user_id          Int
  subscription_id  String?        @db.VarChar(255)
  amount           Decimal        @db.Decimal(10, 2)
  currency         String         @default("VND") @db.VarChar(10)
  status           PaymentStatus  @default(pending)
  provider         String         @db.VarChar(50)
  provider_tx_id   String?        @unique @db.VarChar(255)
  provider_payload Json?
  paid_at          DateTime?      @db.Timestamptz(6)
  created_at       DateTime?      @default(now()) @db.Timestamptz(6)
  
  subscriptions    subscriptions? @relation(fields: [subscription_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users            users          @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([created_at(sort: Desc)], map: "idx_payments_created")
  @@index([provider_tx_id], map: "idx_payments_provider", where: raw("(provider_tx_id IS NOT NULL)"))
  @@index([status], map: "idx_payments_status")
  @@index([user_id], map: "idx_payments_user")
}

model subscription_plans {
  id                  Int             @id @default(autoincrement())
  name                String          @db.VarChar(100)
  tier                PlanTier        @default(basic)
  duration_days       Int             @default(30)
  price               Decimal         @default(0) @db.Decimal(10, 2)
  currency            String          @default("VND") @db.VarChar(10)
  max_links           Int             @default(5)
  max_custom_links    Int             @default(0)
  max_qr_codes        Int             @default(0)  // 0=disabled, -1=unlimited
  reset_period        ResetPeriod     @default(monthly)
  allow_analytics     Boolean         @default(false)
  allow_expiry        Boolean         @default(false)
  allow_custom_domain Boolean         @default(false)
  allow_qr_code       Boolean         @default(true)
  is_active           Boolean         @default(true)
  sort_order          Int             @default(0)
  created_at          DateTime?       @default(now()) @db.Timestamptz(6)
  
  subscriptions       subscriptions[]
}

model subscriptions {
  id                 String             @id @default(cuid()) @db.VarChar(255)
  user_id            Int
  plan_id            Int
  status             SubscriptionStatus @default(pending)
  started_at         DateTime           @default(now()) @db.Timestamptz(6)
  expires_at         DateTime           @db.Timestamptz(6)
  created_at         DateTime?          @default(now()) @db.Timestamptz(6)
  
  payments           payments[]
  subscription_plans subscription_plans @relation(fields: [plan_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users              users              @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expires_at], map: "idx_subscriptions_expires", where: raw("(status = 'active'::\"SubscriptionStatus\")"))
  @@index([user_id, status], map: "idx_subscriptions_user_status")
}

model url_mappings {
  id         BigInt    @id @default(autoincrement())
  short_code String?   @unique @db.VarChar(10)
  long_url   String
  user_id    Int
  title      String?   @db.VarChar(255)
  is_custom  Boolean?  @default(false)
  is_active  Boolean?  @default(true)
  has_qr     Boolean   @default(false)  // true when a qr_codes row is linked
  
  // Đã xóa cột click_count
  
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  expires_at DateTime? @db.Timestamptz(6)
  
  click_logs click_logs[]
  qr_codes   qr_codes[]
  users      users        @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expires_at], map: "idx_url_expires_at")
  @@index([long_url, user_id], map: "idx_url_long_url", where: raw("((is_custom = false) AND (is_active = true))"))
  @@index([user_id], map: "idx_url_user_id")
}

model user_link_monthly_usage {
  user_id           Int
  year_month        String @db.Char(7)
  link_count        Int    @default(0)
  custom_link_count Int    @default(0)
  qr_code_count     Int    @default(0)  // QR codes created this month
  
  users             users  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, year_month])
}

model qr_codes {
  id              BigInt    @id @default(autoincrement())
  user_id         Int
  url_mapping_id  BigInt?   // nullable — QR can exist without a short link

  // QR content
  destination_url String
  short_code      String?   @db.VarChar(10)

  // Visual config (persisted so user can re-download with same style)
  title           String?   @db.VarChar(255)
  fg_color        String    @default("#000000") @db.VarChar(7)
  bg_color        String    @default("#ffffff") @db.VarChar(7)
  error_correction String   @default("Q") @db.VarChar(1)  // L, M, Q, H
  size            Int       @default(300)

  // Cloudinary storage
  cloudinary_public_id  String?  @db.VarChar(255)
  cloudinary_url        String?

  // Status
  is_active  Boolean  @default(true)
  scan_count Int      @default(0)

  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)

  users        users         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  url_mappings url_mappings? @relation(fields: [url_mapping_id], references: [id], onDelete: SetNull)

  @@index([user_id, created_at(sort: Desc)], map: "idx_qr_user_created")
  @@index([url_mapping_id], map: "idx_qr_url_mapping")
  @@index([short_code], map: "idx_qr_short_code")
}

model users {
  id                      Int                       @id @default(autoincrement())
  email                   String                    @unique @db.VarChar(255)
  password_hash           String                    @db.VarChar
  full_name               String                    @db.VarChar(255)
  role                    String?                   @default("user") @db.VarChar(50)
  created_at              DateTime?                 @default(now()) @db.Timestamptz(6)
  updated_at              DateTime?                 @default(now()) @db.Timestamptz(6)
  
  click_logs              click_logs[]              // Quan hệ mới thêm từ click_logs
  payments                payments[]
  qr_codes                qr_codes[]
  subscriptions           subscriptions[]
  url_mappings            url_mappings[]
  user_link_monthly_usage user_link_monthly_usage[]
}

enum PaymentStatus {
  pending
  completed
  failed
  refunded
}

enum PlanTier {
  free
  basic
  premium
  enterprise
}

enum ResetPeriod {
  never
  monthly
  yearly
}

enum SubscriptionStatus {
  pending
  active
  expired
  cancelled
}